{
  "name": "grandicast",
  "version": "1.0.3",
  "main": "src/main.cjs",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bunx electron .",
    "test": "node --test test/cli.test.cjs test/main.integration.test.cjs",
    "test:ui": "node test/run-ui-tests.cjs",
    "test:e2e": "node --test test/ndi.e2e.test.cjs",
    "rebuild": "bunx electron-rebuild -f -w grandi",
    "package": "bunx electron-forge package",
    "make": "bunx electron-forge make",
    "postinstall": "electron-builder install-app-deps",
    "build": "electron-builder --windows",
    "release": "electron-builder --windows --linux --publish always"
  },
  "author": "Felix Adrian",
  "description": "Electron application that captures web content from any URL and broadcasts it as NDI video sources for live video production workflows",
  "license": "Apache-2.0",
  "config": {
    "forge": {
      "packagerConfig": {
        "asar": false,
        "name": "Grandicast",
        "icon": "./icon",
        "executableName": "grandicast"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "Grandicast"
          }
        },
        {
          "name": "@electron-forge/maker-zip"
        },
        {
          "name": "@electron-forge/maker-dmg",
          "config": {
            "format": "ULFO"
          }
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ],
      "outDir": "build"
    }
  },
  "dependencies": {
    "grandi": "^2.0.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@types/bun": "latest",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
